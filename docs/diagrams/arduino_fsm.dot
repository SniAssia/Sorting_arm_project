digraph Arm {
 graph [rankdir=LR, bgcolor="white", splines=polyline, nodesep=0.6, ranksep=0.95, pad=0.2, fontname="DejaVu Sans"];
 node [shape=box, style="rounded,filled", fillcolor="#E8F0FA", color="#456785", fontsize=11, fontname="DejaVu Sans", margin="0.15,0.12"];
 edge [color="#58758C", fontsize=9, arrowsize=0.7, fontname="DejaVu Sans"];
 DISARMED [fillcolor="#F4EDE9"];
 ARMED_IDLE [fillcolor="#DDF2E4"];
 MOVING [fillcolor="#D8EDF7"];
 GRIPPER_ACTION [fillcolor="#F9E6CE"];
 WAITING [fillcolor="#F2F0D4"];
 DISARMED -> ARMED_IDLE [label="ARM"];
 ARMED_IDLE -> OPENING [label="RUN / grip closed"];
 ARMED_IDLE -> MOVING [label="RUN / grip open"];
 OPENING -> MOVING [label="opened"];
 MOVING -> GRIPPER_ACTION [label="PICK or DROP"];
 MOVING -> WAITING [label="other nonfinal waypoint"];
 GRIPPER_ACTION -> WAITING [label="grip completed"];
 WAITING -> MOVING [label="1 s (RUN) / NEXT (MANUAL)"];
 MOVING -> ARMED_IDLE [label="step 8 HOME complete"];
 MOVING -> ARMED_IDLE [label="STOP"];
 GRIPPER_ACTION -> ARMED_IDLE [label="STOP"];
 WAITING -> ARMED_IDLE [label="STOP"];
 OPENING -> ARMED_IDLE [label="STOP"];
}
