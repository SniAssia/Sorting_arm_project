digraph SEVEN_SlotController {
  graph [label="Three-slot capacity-aware controller (software decision logic)",labelloc=t,fontsize=19,
    rankdir=LR,overlap=false,splines=true,pad=0.3,nodesep=0.32,ranksep=0.65];
  node [shape=box, style="rounded,filled",fillcolor="#EDF4FA",color="#34445B",fontname="DejaVu Sans",fontsize=10,margin="0.13,0.09"];
  edge [color="#51657C",fontname="DejaVu Sans",fontsize=9,arrowsize=0.7];
  READY [shape=ellipse,fillcolor="#D4EDE2"];
  SET [label="SET approach/drop"];
  CHECK [label="CHECK route"];
  CONFIRM [label="Human approval"];
  PENDING [label="Persist PENDING",fillcolor="#FFF3D5"];
  RUN [label="ARM / RUN"];
  OBSERVE [label="Observe physical placement"];
  COMMIT [label="COMMIT count +1",fillcolor="#D4EDE2"];
  REVIEW [label="PENDING REVIEW",fillcolor="#FFE5CD"];
  FULL [fillcolor="#FFDFDC"];
  UNCALIBRATED [fillcolor="#FFDFDC"];
  UNKNOWN [fillcolor="#F2F2F2"];
  CANCEL [fillcolor="#F2F2F2"];
  READY -> UNKNOWN [label="unknown color"];
  READY -> FULL [label="count = 3"];
  READY -> UNCALIBRATED [label="next slot missing"];
  READY -> SET [label="slot configured"];
  SET -> CHECK [label="SET acks"];
  CHECK -> CONFIRM [label="reachability OK"];
  CHECK -> CANCEL [label="error"];
  CONFIRM -> CANCEL [label="decline"];
  CONFIRM -> PENDING [label="approve"];
  PENDING -> RUN [label="state saved"];
  RUN -> OBSERVE [label="commands complete"];
  RUN -> REVIEW [label="timeout / error"];
  OBSERVE -> REVIEW [label="not verified"];
  OBSERVE -> COMMIT [label="visually confirmed"];
  REVIEW -> COMMIT [label="resolve: placed"];
  REVIEW -> CANCEL [label="resolve: not placed"];
  COMMIT -> READY [label="next object"];
  CANCEL -> READY [label="next object"];
  FULL -> READY [label="bin emptied + reset"];
  UNCALIBRATED -> READY [label="physical calibration"];
  UNKNOWN -> READY [label="next object"];
}
