digraph BinCapacity {
  graph [rankdir=TB, label="SEVEN bin capacity controller", labelloc=t, fontsize=20, bgcolor="white", pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#e9f3f6", fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#43556a"];
  READY -> COLOR_DETECTED [label="Object classified"];
  COLOR_DETECTED -> READY [label="UNKNOWN"];
  COLOR_DETECTED -> CAPACITY_CHECK [label="Supported color"];
  CAPACITY_CHECK -> FULL [label="Count = 3"];
  FULL -> READY [label="End request"];
  CAPACITY_CHECK -> ROUTE_VALIDATION [label="Count < 3"];
  ROUTE_VALIDATION -> READY [label="Rejected or timeout"];
  ROUTE_VALIDATION -> CONFIRMATION [label="CHECK OK"];
  CONFIRMATION -> READY [label="Declined"];
  CONFIRMATION -> EXECUTION [label="Approved"];
  EXECUTION -> COMPLETION [label="Started then sequence complete"];
  EXECUTION -> PENDING_REVIEW [label="Error, timeout or interruption"];
  COMPLETION -> COUNTER_UPDATE [label="Commit"];
  COMPLETION -> PENDING_REVIEW [label="Interrupted before commit"];
  PENDING_REVIEW -> COUNTER_UPDATE [label="Stopped, inspected, placed and confirmed"];
  PENDING_REVIEW -> READY [label="Stopped, inspected, not placed and confirmed"];
  COUNTER_UPDATE -> READY [label="Saved"];
  READY -> MANUAL_RESET [label="Idle, emptied and reset confirmed"];
  MANUAL_RESET -> READY [label="Saved"];
}
